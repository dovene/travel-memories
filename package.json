{
  "name": "travel-memories",
  "version": "0.3.0",
  "private": true,
  "description": "Personal travel publishing platform on Cloudflare Workers + R2.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "validate": "npm run check && npm test",
    "build": "wrangler deploy --dry-run --outdir dist --env staging && wrangler deploy --dry-run --outdir dist --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "serve:prototype": "python3 scripts/serve.py",
    "seed:local": "node scripts/seed-content.js --target local",
    "setup:admin": "node scripts/setup-admin.js"
  },
  "devDependencies": {
    "wrangler": "4.153.0"
  }
}
